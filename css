/* Title Section Adjustments */
.title {
  padding: 20px 0; /* Keep it moderate for balance */
}

/* Button Row Adjustments */
.button-row {
  margin-top: 25px; /* Adds some spacing for visual balance */
  display: flex;
  gap: 25px;
  justify-content: center;
}

/* Hero Section Adjustments */
.hero-section {
  padding-top: 30px; /* Slightly increased top padding for spacious feel */
  padding-bottom: 30px; /* Slightly increased bottom padding */
}

/* About Section */
.about {
  padding: 60px 20px; /* Clean and balanced padding */
  background: #fff;
  text-align: center;
}

.about h1 {
  font-size: 2.5rem;
  margin-bottom: 20px;
  font-weight: 700;
  color: #ff3333;
}

.about p {
  max-width: 700px;
  margin: 0 auto;
  line-height: 1.6;
  color: gray;
}

/* Services Section */
.services {
  padding: 60px 80px; /* Balanced padding for spacious look */
  background: #fbfbfb;
  text-align: center;
}

.services h1 {
  font-size: 2.5rem;
  font-weight: 700;
  color: #66cc33;
  margin-bottom: 40px;
}

.services h3 {
  font-weight: 500;
  font-size: 1.25rem;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  padding: 15px;
  color: #66cc33;
}

.services p {
  color: gray;
  font-size: small;
}

.container-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30px;
}

.service-box {
  flex: 1 1 250px;
  max-width: 350px;
  padding: 30px;
  border: 1px solid #ffffff;
  border-radius: 12px;
  background: hsl(0, 0%, 100%);
  transition: 0.3s;
}

.service-box:hover {
  border-color: #66cc33;
  background: rgba(238, 238, 238, 0);
}

/* Buttons */
.button-row {
  margin-top: 25px; /* A bit more space for button row */
  display: flex;
  gap: 25px;
  justify-content: center;
}

.btn {
  padding: 12px 28px; /* Slightly larger padding for a clean look */
  border-radius: 8px;
  border: none;
  background: #35a9e1;
  color: white;
  font-size: 1rem;
  cursor: pointer;
  transition: 0.3s;
}

.btn:hover {
  background: #2563eb;
}

.btn-alt {
  background: whitesmoke;
  color:black;
}

.btn-alt:hover {
  background: #15803d;
}

/* Contact Section */


.contact h1 {
  font-size: 2.5rem;
  margin-bottom: 20px;
}

.contact p {
  font-size: 1.2rem;
  margin: 10px 0;
}

/* Hero logo */
.hero-logo {
  height: 250px;
  width: auto;
}

#heroTitle2 {
  color: #35a9e1;
}

/* Scroll Animations */
.animate-on-scroll {
  opacity: 0;
  transform: translateY(40px);
  transition: all 0.8s ease-out;
}

.animate-on-scroll.visible {
  opacity: 1;
  transform: translateY(0);
}

.stagger {
  transition-delay: var(--delay, 0s);
}

/* Typing animation */
@keyframes typing {
  from { width: 0 }
  to { width: 100% }
}

@keyframes blink {
  50% { border-color: transparent }
}

.typing {
  overflow: hidden;
  white-space: nowrap;
  border-right: .15em solid black;
  animation: typing 3s steps(30, end) forwards, blink .75s step-end infinite;
}

.typing.end {
  border-right: none;
}

@keyframes typing2 {
  from { width: 0 }
  to { width: 100% }
}

@keyframes blink2 {
  50% { border-color: transparent }
}

.typing2 {
  overflow: hidden;
  white-space: nowrap;
  border-right: .15em solid #35a9e1;
  animation: typing2 3s steps(30, end) forwards, blink2 .75s step-end infinite;
}

.typing2.end2 {
  border-right: none;
}
